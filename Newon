<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Newonvzla - Streaming Premium Venezuela | Netflix, Disney+, Paramount+</title>
    <meta name="description" content="Newonvzla - Cuentas premium de Netflix, Disney+, Paramount+, Crunchyroll, Prime Video y Spotify. Precios accesibles, soporte 24/7.">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Orbitron:wght@400;500;700;900&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Outfit', sans-serif;
            background: #050508;
            color: white;
            overflow-x: hidden;
        }

        .font-brand {
            font-family: 'Orbitron', sans-serif;
        }

        .bg-cinematic {
            background: radial-gradient(ellipse at top, #0a1628 0%, #050508 50%, #000000 100%);
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
        }

        .particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
        }

        .particle {
            position: absolute;
            width: 2px;
            height: 2px;
            background: rgba(59, 130, 246, 0.5);
            border-radius: 50%;
            animation: float-particle 15s infinite;
        }

        @keyframes float-particle {
            0%, 100% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { transform: translateY(-100vh) rotate(720deg); opacity: 0; }
        }

        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.3;
            z-index: -1;
            animation: pulse-orb 8s infinite ease-in-out;
        }

        .orb-1 {
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, #3b82f6 0%, transparent 70%);
            top: -200px;
            right: -200px;
        }

        .orb-2 {
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, #1d4ed8 0%, transparent 70%);
            bottom: -100px;
            left: -100px;
            animation-delay: 2s;
        }

        .orb-3 {
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, #60a5fa 0%, transparent 70%);
            top: 50%;
            left: 30%;
            animation-delay: 4s;
        }

        @keyframes pulse-orb {
            0%, 100% { transform: scale(1); opacity: 0.3; }
            50% { transform: scale(1.2); opacity: 0.5; }
        }

        .metallic-card {
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.9) 100%);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(59, 130, 246, 0.2);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37), 
                        inset 0 1px 0 rgba(255, 255, 255, 0.1);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .metallic-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.1), transparent);
            transition: left 0.7s;
        }

        .metallic-card:hover::before {
            left: 100%;
        }

        .metallic-card:hover {
            border-color: rgba(59, 130, 246, 0.5);
            transform: translateY(-8px);
            box-shadow: 0 20px 60px rgba(59, 130, 246, 0.2),
                        inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }

        .logo-container {
            position: relative;
            display: inline-block;
            cursor: pointer;
        }

        .logo-glow {
            position: absolute;
            inset: -10px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.4) 0%, transparent 70%);
            filter: blur(20px);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .logo-container:hover .logo-glow {
            opacity: 1;
        }

        .brand-blue { color: #3b82f6; }
        .brand-glow { text-shadow: 0 0 20px rgba(59, 130, 246, 0.5); }
        
        .btn-brand {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 50%, #1e40af 100%);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(96, 165, 250, 0.3);
            box-shadow: 0 0 20px rgba(37, 99, 235, 0.3),
                        inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }

        .btn-brand::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.5s;
        }

        .btn-brand:hover::before {
            left: 100%;
        }

        .btn-brand:hover {
            transform: scale(1.05);
            box-shadow: 0 0 30px rgba(37, 99, 235, 0.5),
                        inset 0 1px 0 rgba(255, 255, 255, 0.3);
        }

        .netflix-style { 
            background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
            box-shadow: 0 10px 30px rgba(220, 38, 38, 0.3);
        }
        .disney-style { 
            background: linear-gradient(135deg, #113ccf 0%, #1e40af 100%);
            box-shadow: 0 10px 30px rgba(17, 60, 207, 0.3);
        }
        .paramount-style { 
            background: linear-gradient(135deg, #0064ff 0%, #00a8e1 100%);
            box-shadow: 0 10px 30px rgba(0, 100, 255, 0.3);
        }
        .crunchy-style { 
            background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
            box-shadow: 0 10px 30px rgba(249, 115, 22, 0.3);
        }
        .prime-style { 
            background: linear-gradient(135deg, #00a8e1 0%, #0891b2 100%);
            box-shadow: 0 10px 30px rgba(0, 168, 225, 0.3);
        }
        .spotify-style {
            background: linear-gradient(135deg, #1db954 0%, #1ed760 100%);
            box-shadow: 0 10px 30px rgba(29, 185, 84, 0.3);
        }

        .price-pulse {
            animation: price-glow 2s infinite;
        }

        @keyframes price-glow {
            0%, 100% { text-shadow: 0 0 10px rgba(74, 222, 128, 0.5); }
            50% { text-shadow: 0 0 20px rgba(74, 222, 128, 0.8), 0 0 30px rgba(74, 222, 128, 0.4); }
        }

        .metallic-text {
            background: linear-gradient(135deg, #ffffff 0%, #94a3b8 50%, #ffffff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .mobile-menu {
            transform: translateX(100%);
            transition: transform 0.3s ease-in-out;
            background: rgba(5, 5, 8, 0.98);
            backdrop-filter: blur(20px);
        }

        .mobile-menu.active {
            transform: translateX(0);
        }

        .gradient-text {
            background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 50%, #2563eb 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .vzla-accent {
            background: linear-gradient(90deg, #fcd34d 0%, #3b82f6 50%, #ef4444 100%);
            height: 3px;
            width: 60px;
            margin: 0 auto;
            border-radius: 2px;
        }
    </style>
</head>
<body>
    <div class="bg-cinematic"></div>
    <div class="particles" id="particles"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <nav class="fixed w-full z-50 top-0 transition-all duration-300" id="navbar">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-24">
                <div class="logo-container" onclick="window.scrollTo(0,0)">
                    <div class="logo-glow"></div>
                    <div>
                        <span class="font-brand text-2xl font-bold metallic-text tracking-wider">NEWONVZLA</span>
                        <div class="text-xs text-blue-400 tracking-[0.3em] uppercase">Streaming Oficial</div>
                    </div>
                </div>
                
                <div class="hidden md:flex items-center space-x-8">
                    <a href="#servicios" class="text-gray-300 hover:text-blue-400 transition-colors text-sm font-medium tracking-wide uppercase">Servicios</a>
                    <a href="#testimonios" class="text-gray-300 hover:text-blue-400 transition-colors text-sm font-medium tracking-wide uppercase">Testimonios</a>
                    <a href="#faq" class="text-gray-300 hover:text-blue-400 transition-colors text-sm font-medium tracking-wide uppercase">FAQ</a>
                    <a href="https://wa.link/q1jdcs" target="_blank" class="btn-brand px-6 py-3 rounded-full text-white font-bold text-sm tracking-wide uppercase">
                        Comprar Ahora
                    </a>
                </div>
            </div>
        </div>

        <div class="mobile-menu fixed top-0 right-0 w-80 h-full z-50 p-8 border-l border-blue-500/20" id="mobile-menu">
            <div class="flex flex-col space-y-8 mt-16">
                <a href="#servicios" class="text-gray-300 hover:text-blue-400 text-lg font-medium">Servicios</a>
                <a href="#testimonios" class="text-gray-300 hover:text-blue-400 text-lg font-medium">Testimonios</a>
                <a href="#faq" class="text-gray-300 hover:text-blue-400 text-lg font-medium">FAQ</a>
                <a href="https://wa.link/q1jdcs" target="_blank" class="btn-brand px-6 py-4 rounded-full text-white font-bold text-center">Comprar Ahora</a>
            </div>
        </div>
    </nav>

    <section class="relative min-h-screen flex items-center justify-center pt-24 px-4 overflow-hidden">
        <div class="max-w-7xl mx-auto text-center relative z-10">
            <h1 class="font-brand text-5xl md:text-7xl lg:text-8xl font-black mb-6 leading-none tracking-tight">
                <span class="block metallic-text mb-2">NEWONVZLA</span>
                <span class="block text-2xl md:text-4xl lg:text-5xl font-medium text-gray-400 mt-4 tracking-[0.2em] uppercase">Streaming Premium</span>
            </h1>
            
            <div class="vzla-accent mb-8"></div>

            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
                <a href="https://wa.link/q1jdcs" target="_blank" class="btn-brand px-10 py-5 rounded-full text-white font-bold text-lg flex items-center space-x-3 group shadow-2xl shadow-blue-500/30">
                    <span>Comprar Ahora</span>
                </a>
            </div>
        </div>
    </section>

    <section id="servicios" class="py-24 px-4 relative">
        <div class="max-w-7xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <div class="service-card metallic-card rounded-3xl p-8 relative group">
                    <a href="https://wa.link/q1jdcs" target="_blank" class="block w-full py-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold transition-all uppercase tracking-wider text-sm hover:border-blue-500/50 text-center">
                        Seleccionar Plan
                    </a>
                </div>
            </div>
        </div>
    </section>
</body>
</html>
